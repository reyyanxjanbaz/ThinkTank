# ---- Server ----
# production enables strict env checks (Supabase, LLM key, CORS_ORIGIN required).
NODE_ENV=development
PORT=3001
# Interface to bind. 0.0.0.0 is right for containers and most hosts.
HOST=0.0.0.0
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# Set true (or a hop count) when running behind a hosting proxy so rate limits see the real client IP.
TRUST_PROXY=false

# ---- CORS ----
# Comma-separated web origins, no trailing slash. Required in production; empty = allow all (dev only).
CORS_ORIGIN=http://localhost:5173

# ---- Supabase (server only: the service-role key must never go in a VITE_* variable) ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=artifacts
SUPABASE_EXPORT_BUCKET=exports
# Without Supabase the API keeps sessions in memory. Defaults to true in development, false in production.
ALLOW_MEMORY_STORE=true

# ---- LLM provider (one key is required in production) ----
# OPENROUTER_API_KEY takes precedence over OPENAI_API_KEY when both are set.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
# Optional provider endpoint override.
OPENAI_BASE_URL=
# Sent to OpenRouter as the referring site; use your deployed web origin.
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=Think Tank
# Leave empty for the default: openai/gpt-4o-mini (OpenRouter) or gpt-4o-mini (OpenAI).
OPENAI_MODEL=
OPENAI_TEMPERATURE=0.7

# ---- Limits ----
# Max upload size in bytes (default 5 MiB).
MAX_ARTIFACT_SIZE=5242880
# LLM requests (streams + titles) allowed per client IP per minute.
RATE_LIMIT_MAX=30

# ---- Debug ----
# Enables POST /api/prompt-preview. Keep false in production.
PROMPT_PREVIEW=false
