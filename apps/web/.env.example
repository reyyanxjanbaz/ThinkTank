# Everything here is compiled into the public JS bundle. Never put secrets
# (like SUPABASE_SERVICE_ROLE_KEY) in a VITE_* variable.

# Supabase project URL and the public anon key (not the service-role key).
# Leave both empty to run in local mode without sign-in.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Deployed API origin, no trailing slash, e.g. https://thinktank-api.onrender.com
# Required for production builds; in development it defaults to http://localhost:3001.
VITE_API_URL=http://localhost:3001
# Where Supabase auth emails send users back to. Defaults to the current page origin.
VITE_AUTH_REDIRECT_URL=http://localhost:5173
